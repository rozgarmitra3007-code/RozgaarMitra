{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*(.*)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/candidates",
      "dest": "/api/candidates.js"
    },
    {
      "src": "/api/applications",
      "dest": "/api/applications.js"
    },
    {
      "src": "/api/send-otp",
      "dest": "/api/send-otp.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
