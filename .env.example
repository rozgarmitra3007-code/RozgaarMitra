# ROZGAAR MITRA (rozgaarmitra.com) - ENVIRONMENT CONFIGURATION

# Database Connection (PostgreSQL on Railway / Supabase / Render / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rozgaarmitra?schema=public"

# App & Domain Settings
NEXTAUTH_URL="https://rozgaarmitra.com"
NEXTAUTH_SECRET="super-secret-random-jwt-key-change-in-production-rozgaar-2026"

# Cloudinary / Firebase File Storage (For PDF Resumes & Candidate Photos)
CLOUDINARY_CLOUD_NAME="rozgaarmitra"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="your-cloudinary-secret"

# Optional Email / SMS Notifications (Twilio / Fast2SMS / Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="support@rozgaarmitra.com"
SMTP_PASS="your-app-password"
